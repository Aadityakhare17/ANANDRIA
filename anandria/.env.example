# ============================================================
# ANANDRIA – GenAI Event Planning Assistant
# Environment Variables
# ============================================================

# Google Gemini API Key (required for live AI generation)
# Get your key at: https://aistudio.google.com/app/apikey
# If left empty or not provided, the app runs in Demo/Mock Mode
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Force demo mode even if API key is present (true/false)
VITE_DEMO_MODE=false
