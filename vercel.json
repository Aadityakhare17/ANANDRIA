{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "anandria",
          "format": "url",
          "env": "ANANDRIA_SERVICE_URL"
        }
      ]
    },
    "anandria": {
      "root": "anandria",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
