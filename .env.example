# ============================================================
# ANANDRIA – GenAI Event Planning Assistant
# Environment Variables
# ============================================================

# Google Gemini API Key (required for live GenAI generation)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
# If left empty, ANANDRIA runs in high-fidelity Demo / Mock Simulator mode
GEMINI_API_KEY=""

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Operational Mode
# Set to 'true' to force demo/mock mode even if an API key is set
DEMO_MODE=false
